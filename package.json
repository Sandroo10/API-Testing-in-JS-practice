{
  "name": "api-automation-cucumber-js",
  "version": "1.0.0",
  "private": true,
  "description": "A learning-first black-box API automation portfolio project using Cucumber.js.",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags \"@smoke\"",
    "test:regression": "cucumber-js --tags \"@regression\"",
    "test:negative": "cucumber-js --tags \"@negative\"",
    "test:report": "cucumber-js --format json:reports/cucumber-report.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.2",
    "chai": "^5.3.3",
    "dotenv": "^17.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
